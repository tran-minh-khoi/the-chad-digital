# Copy to .env on the VPS (used by docker-compose.prod.yml). Never commit the real .env.
API_DOMAIN=api.example.com                 # DNS A record -> this VPS; Caddy gets the HTTPS cert for it
CORS_ORIGIN=https://your-app.vercel.app    # frontend origin(s), comma-separated, no trailing slash
# TICK_MS=1000
# STRATEGY=nearest
